# TheMauler profiles example
#
# Configure providers and profiles through Control Center in the Mauler UI.
# This file documents the persisted shape and the verified local defaults; it is
# not required for normal setup.

[providers]
  [providers.inference-bridge]
    name = "inference-bridge"
    backend = "llamacpp"
    base_url = "http://127.0.0.1:8800/v1"
    api_key_env = ""

  [providers.openrouter]
    name = "openrouter"
    backend = "openai-compatible"
    base_url = "https://openrouter.ai/api/v1"
    api_key_env = "OPENROUTER_API_KEY"

[profiles]
  # 2026-07-21 local tournament winner for the user's RTX 3090 24 GB.
  # The exact GGUF template is code-owned. Mauler may enable native draft-mtp
  # only after inspecting the artifact; MTP calibration remains machine-specific.
  [profiles."qwen3.6-nothink"]
    name = "qwen3.6-nothink"
    provider = "inference-bridge"
    model_id = "Qwen3.6-27B-UD-Q4_K_XL.gguf"
    ctx_tokens = 35000
    thinking = false
    preserve_thinking = false
    mmproj = ""
    spec_type = ""
    spec_draft_n_max = 0
    spec_draft_model = ""

    [profiles."qwen3.6-nothink".thinking_general]
      temperature = 1.0
      top_p = 0.95
      top_k = 20
      min_p = 0.0
      presence_penalty = 0.0
      repeat_penalty = 1.05
      max_tokens = 8192
      seed = -1

    [profiles."qwen3.6-nothink".thinking_coding]
      temperature = 0.6
      top_p = 0.95
      top_k = 20
      min_p = 0.0
      presence_penalty = 0.0
      repeat_penalty = 1.05
      max_tokens = 8192
      seed = -1

    [profiles."qwen3.6-nothink".nothinking]
      temperature = 0.2
      top_p = 0.95
      top_k = 20
      min_p = 0.0
      presence_penalty = 0.0
      repeat_penalty = 1.05
      max_tokens = 8192
      seed = -1
