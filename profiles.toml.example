# TheMauler profiles example
#
# Configure providers and profiles through Control Center in the Mauler UI.
# This file documents the persisted shape and the verified local defaults; it is
# not required for normal setup.

[providers]
  [providers.inference-bridge]
    name = "inference-bridge"
    backend = "llamacpp"
    base_url = "http://127.0.0.1:8800/v1"
    api_key_env = ""

  [providers.openrouter]
    name = "openrouter"
    backend = "openai-compatible"
    base_url = "https://openrouter.ai/api/v1"
    api_key_env = "OPENROUTER_API_KEY"

[profiles]
  # 2026-08-16 Qwen3.8 default for the user's RTX 3090 24 GB.
  # The exact GGUF template is code-owned. Native draft-mtp n=2 is a conservative
  # starting point and must still be measured against MTP-off on this machine.
  [profiles."qwen3.8-agent-stability"]
    name = "qwen3.8-agent-stability"
    provider = "inference-bridge"
    model_id = "Qwen3.8-27B-Q4_K_M.gguf"
    ctx_tokens = 35000
    thinking = true
    preserve_thinking = true
    mmproj = ""
    # Quality-first default. Use q8_0 when a long-context profile needs more
    # VRAM headroom; custom allows different key/value cache types.
    kv_cache_precision = "f16"
    kv_cache_type_k = "f16"
    kv_cache_type_v = "f16"
    spec_type = "draft-mtp"
    spec_draft_n_max = 2
    spec_draft_model = ""

    [profiles."qwen3.8-agent-stability".thinking_general]
      temperature = 1.0
      top_p = 0.95
      top_k = 20
      min_p = 0.0
      presence_penalty = 0.0
      repeat_penalty = 1.0
      max_tokens = 8192
      seed = -1

    [profiles."qwen3.8-agent-stability".thinking_coding]
      temperature = 1.0
      top_p = 0.95
      top_k = 20
      min_p = 0.0
      presence_penalty = 0.0
      repeat_penalty = 1.0
      max_tokens = 8192
      seed = -1

    [profiles."qwen3.8-agent-stability".nothinking]
      temperature = 0.7
      top_p = 0.8
      top_k = 20
      min_p = 0.0
      presence_penalty = 1.5
      repeat_penalty = 1.0
      max_tokens = 8192
      seed = -1
